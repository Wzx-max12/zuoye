                and status = #{query.status}
            </if>
        </where>
        ORDER BY id DESC
    </select>
    <select id="test" resultType="User">
        select * from sys_user
        <where>
        <if test="username != null and username.trim() != ''">
            username = #{username}
        </if>
        </where>
    </select>

</mapper>

